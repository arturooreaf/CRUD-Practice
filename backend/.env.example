# Cadena de conexión a PostgreSQL.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?schema=public

# Opción A — Postgres local vía docker-compose (ver docker-compose.yml en la raíz):
DATABASE_URL="postgresql://health:health@localhost:5432/health_crud?schema=public"

# Opción B — Postgres en la nube (Neon, Supabase, Railway...):
# DATABASE_URL="postgresql://usuario:password@host.neon.tech/dbname?sslmode=require"

# Puerto del backend (opcional, por defecto 3001)
PORT=3001
